<%- include('partials/header') %>
<main class="container">
  <div class="page-title"><div><div class="small-title">SUPERVISOR WORKSPACE</div><h1>Manage duty hours.</h1><p>Create duty slots and record the hours completed by scholars.</p></div><span class="role"><%= user.role %></span></div>
  <div class="two-columns">
    <section class="panel"><h2>Create duty slot</h2><form method="post" action="/slots/add" class="form-grid">
      <label>Duty title<input name="title" required></label><label>Department<input name="department" required></label>
      <label>Date<input type="date" name="duty_date" required></label><label>Start time<input type="time" name="start_time" required></label>
      <label>End time<input type="time" name="end_time" required></label><label>Location<input name="location" required></label>
      <label>Maximum students<input type="number" name="max_students" min="1" required></label>
      <button type="submit">Add duty slot</button>
    </form></section>
    <section class="panel"><h2>Record duty hours</h2><form method="post" action="/logs/add" class="form-grid">
      <label>Student<select name="student_id" required><option value="">Choose student</option><% students.forEach(function(s) { %><option value="<%= s.id %>"><%= s.full_name %></option><% }) %></select></label>
      <label>Date<input type="date" name="duty_date" required></label><label>Location<input name="location" required></label>
      <label>Position<input name="position_name" required></label><label>Hours<input type="number" name="hours" min="0.25" max="24" step="0.25" required></label>
      <label>Semester<input name="semester" placeholder="2026-1" required></label><button type="submit">Save duty hours</button>
    </form></section>
  </div>
  <section class="panel"><h2>My duty slots</h2><div class="table-wrap"><table><tr><th>Title</th><th>Department</th><th>Date</th><th>Time</th><th>Location</th><th>Max students</th></tr>
  <% slots.forEach(function(s) { %><tr><td><%= s.title %></td><td><%= s.department %></td><td><%= s.duty_date %></td><td><%= s.start_time %> - <%= s.end_time %></td><td><%= s.location %></td><td><%= s.max_students %></td></tr><% }) %></table></div></section>
  <section class="panel"><h2>Duty logs (CRUD)</h2><p class="hint">Edit or delete a duty record if it was entered incorrectly.</p><div class="table-wrap"><table><tr><th>Student</th><th>Date</th><th>Location</th><th>Position</th><th>Hours</th><th>Semester</th><th>Actions</th></tr>
  <% logs.forEach(function(l) { %><tr><td><%= l.full_name %></td><td colspan="5"><form method="post" action="/logs/edit/<%= l.id %>" class="inline-edit"><input type="date" name="duty_date" value="<%= l.duty_date %>" required><input name="location" value="<%= l.location %>" required><input name="position_name" value="<%= l.position_name %>" required><input type="number" name="hours" value="<%= l.hours %>" min="0.25" max="24" step="0.25" required><input name="semester" value="<%= l.semester %>" required><button class="small-button" type="submit">Update</button></form></td><td><a class="delete" href="/logs/delete/<%= l.id %>" onclick="return confirm('Delete this duty log?')">Delete</a></td></tr><% }) %>
  </table></div></section>
</main><%- include('partials/footer') %>