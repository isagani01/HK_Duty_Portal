<%- include('partials/header') %>
<main class="container">
  <div class="page-title"><div><div class="small-title">STUDENT DASHBOARD</div><h1>Hello, <%= user.full_name %>.</h1><p>View your duty opportunities and recorded hours.</p></div><span class="role"><%= user.role %></span></div>
  <section class="cards">
    <div class="stat"><span>Recorded entries</span><strong><%= logs.length %></strong></div>
    <div class="stat"><span>Upcoming slots</span><strong><%= slots.length %></strong></div>
    <div class="stat"><span>Semesters tracked</span><strong><%= balances.length %></strong></div>
  </section>
  <section class="panel"><h2>Upcoming duty slots</h2><div class="table-wrap"><table><tr><th>Duty</th><th>Department</th><th>Date</th><th>Time</th><th>Location</th><th>Capacity</th></tr>
  <% slots.forEach(function(s) { %><tr><td><%= s.title %></td><td><%= s.department %></td><td><%= s.duty_date %></td><td><%= s.start_time %> - <%= s.end_time %></td><td><%= s.location %></td><td><%= s.max_students %> students</td></tr><% }) %>
  </table></div></section>
  <section class="panel"><h2>My recorded duty hours</h2><div class="table-wrap"><table><tr><th>Date</th><th>Location</th><th>Position</th><th>Semester</th><th>Hours</th></tr>
  <% logs.forEach(function(l) { %><tr><td><%= l.duty_date %></td><td><%= l.location %></td><td><%= l.position_name %></td><td><%= l.semester %></td><td><b><%= l.hours %></b></td></tr><% }) %>
  </table></div></section>
  <section class="panel"><h2>Semester hour totals</h2><div class="table-wrap"><table><tr><th>Semester</th><th>Total rendered hours</th></tr>
  <% balances.forEach(function(b) { %><tr><td><%= b.semester %></td><td><%= b.total_hours %></td></tr><% }) %>
  </table></div></section>
</main>
<%- include('partials/footer') %>