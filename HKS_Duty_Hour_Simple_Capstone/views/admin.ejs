<%- include('partials/header') %>
<main class="container">
  <div class="page-title"><div><div class="small-title">ADMINISTRATION</div><h1>Manage users.</h1><p>Create, read, update, and delete user accounts.</p></div><span class="role">Admin</span></div>
  <section class="panel"><h2>Add new user</h2><form method="post" action="/users/add" class="user-add">
    <label>Full name<input name="full_name" required></label><label>Email<input type="email" name="email" required></label>
    <label>Password<input name="password" required></label><label>Role<select name="role"><option>Student</option><option>Teacher</option><option>Admin</option></select></label><button type="submit">Add user</button>
  </form></section>
  <section class="panel"><h2>User records (CRUD)</h2><div class="table-wrap"><table><tr><th>Name</th><th>Email</th><th>Role</th><th>Actions</th></tr>
  <% users.forEach(function(u) { %><tr><td colspan="3"><form method="post" action="/users/edit/<%= u.id %>" class="inline-edit"><input name="full_name" value="<%= u.full_name %>" required><input type="email" name="email" value="<%= u.email %>" required><select name="role"><option <%= u.role==='Student'?'selected':'' %>>Student</option><option <%= u.role==='Teacher'?'selected':'' %>>Teacher</option><option <%= u.role==='Admin'?'selected':'' %>>Admin</option></select><button class="small-button" type="submit">Update</button></form></td><td><a class="delete" href="/users/delete/<%= u.id %>" onclick="return confirm('Delete this user?')">Delete</a></td></tr><% }) %>
  </table></div></section>
</main><%- include('partials/footer') %>